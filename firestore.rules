rules_version = '2';

// KehDoNa Phase 2: each member can read and write only their own private profile at users/{uid},
// and create (once) and read their own finalized personality profile at personalityProfiles/{uid}.
// Matching runs only in Cloud Functions (Admin SDK, which bypasses these rules): clients can read
// their own matchState and the matches they're part of, and can never write either.
// Tested by firestore-tests/ on the local emulator. Publish via Console › Firestore › Rules, or
// `firebase use --add` then `firebase deploy --only firestore:rules` (firebase.json is already set up).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- Field validation (mirrors domain/Validation.kt and PersonalityPrompt.kt) ---

    // 2–50 characters, starts with a letter, then letters, marks, spaces, . ' - ; no outer spaces.
    function validName(name) {
      return name is string
        && name.size() >= 2 && name.size() <= 50
        && name.trim() == name
        && name.matches("^[\\p{L}\\p{M}][\\p{L}\\p{M} .'-]*$");
    }

    function validEmail(email) {
      return email is string
        && email.size() >= 6 && email.size() <= 254
        && email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
    }

    // E.164, e.g. +919876543210.
    function validPhone(phone) {
      return phone is string && phone.matches("^\\+[1-9][0-9]{6,14}$");
    }

    // Email / phone must be exactly what Firebase Auth put in the caller's ID token.
    function emailMatchesAuth(email) {
      return validEmail(email) && email == request.auth.token.get('email', null);
    }

    function phoneMatchesAuth(phone) {
      return validPhone(phone) && phone == request.auth.token.get('phone_number', null);
    }

    function allowedKeys() {
      return ['name', 'email', 'phoneNumber', 'personalitySkipped', 'gender', 'genderSelfDescription',
              'matchPreference', 'createdAt', 'updatedAt'];
    }

    // Gender and preference are exactly what the member chose (model/Gender.kt); never inferred.
    function validMatchingDetails(data) {
      return (!('gender' in data)
              || data.gender in ['man', 'woman', 'non_binary', 'self_describe', 'prefer_not_to_say'])
        && (!('matchPreference' in data) || data.matchPreference in ['men', 'women', 'all'])
        // The private self-description only exists alongside "self_describe".
        && (!('genderSelfDescription' in data)
              || (data.get('gender', null) == 'self_describe'
                  && data.genderSelfDescription is string
                  && data.genderSelfDescription.size() >= 1 && data.genderSelfDescription.size() <= 40));
    }

    // Type and size checks shared by create and update.
    function validShape(data) {
      return data.keys().hasOnly(allowedKeys())
        && validName(data.name)
        && (!('personalitySkipped' in data) || data.personalitySkipped is bool)
        && validMatchingDetails(data);
    }

    function validCreate(data) {
      return validShape(data)
        && data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        // FieldValue.serverTimestamp() resolves to request.time; client clocks are rejected.
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!('email' in data) || emailMatchesAuth(data.email))
        && (!('phoneNumber' in data) || phoneMatchesAuth(data.phoneNumber));
    }

    function changedKeys(data, existing) {
      return data.diff(existing).affectedKeys();
    }

    function validUpdate(data, existing) {
      return validShape(data)
        && data.createdAt == existing.createdAt
        && data.updatedAt == request.time
        // Contact details may only change to what Firebase Auth currently says.
        && (!changedKeys(data, existing).hasAny(['email']) || emailMatchesAuth(data.email))
        && (!changedKeys(data, existing).hasAny(['phoneNumber']) || phoneMatchesAuth(data.phoneNumber));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validCreate(request.resource.data);
      allow update: if isOwner(uid) && validUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // The finalized personality profile: ChatGPT's reply exactly as imported. It can be created
    // once by its owner and is then permanently read-only for every client.
    function validPersonality(data) {
      return data.keys().hasOnly(['response', 'promptVersion', 'importedAt'])
        && data.keys().hasAll(['response', 'promptVersion', 'importedAt'])
        && data.response is string
        && data.response.size() >= 80 && data.response.size() <= 12000
        && data.promptVersion is int && data.promptVersion >= 1
        && data.importedAt == request.time;
    }

    match /personalityProfiles/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      // Needs the owner's profile to exist first, so the flow order can't be skipped.
      allow create: if isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && validPersonality(request.resource.data);
      allow update, delete: if false;
    }

    // Matching status, written only by the requestMatch / cancelMatchRequest functions.
    match /matchState/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // A confirmed match: first names and shared themes only. Readable by its two members.
    match /matches/{matchId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow list, write: if false;
    }

    // Everything else (including matchQueue and subcollections) stays closed to clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
