{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "lib/test", "test", "*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
